<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="tests/bootstrap.php" backupGlobals="false" colors="true" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd">
  <testsuites>
    <testsuite name="Unit">
      <directory prefix="Test" suffix=".php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Integration">
      <directory prefix="Test" suffix=".php">./tests/Integration</directory>
    </testsuite>
  </testsuites>
</phpunit>
